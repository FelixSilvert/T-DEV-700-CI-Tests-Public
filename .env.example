# Global
NODE_ENV=development
SERVER_NAME=localhost

# Réseau Docker
DOCKER_NETWORK_SUBNET=172.28.0.0/16
DOCKER_NETWORK_GATEWAY=172.28.0.1

# Backend
BACKEND_HOST=trinity-back
BACKEND_INTERNAL_PORT=3000
BACKEND_EXTERNAL_PORT=3000

# Database
DB_HOST=trinity-db
DB_INTERNAL_PORT=5432
DB_EXTERNAL_PORT=5433
DB_DATABASE=ur_database_name
DB_USER=your_database_user
DB_PASSWORD=your_secure_password

# Nginx (reverse proxy)
NGINX_HOST=trinity-proxy
NGINX_INTERNAL_PORT=80
NGINX_EXTERNAL_PORT=80
