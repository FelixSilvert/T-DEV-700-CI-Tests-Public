# Local .env (Docker Compose overrides specific values in container)

# Backend local environment
NODE_ENV=development
PORT=3001

# Default Database connection for NestJS backend (for local dev)
DB_HOST=localhost
DB_PORT=5433
DB_DATABASE=your_database_name
DB_USER=your__user_name
DB_PASSWORD=your_secure_password

# JWT Configuration
JWT_SECRET=your_jwt_secret
JWT_EXPIRATION=24h

# Admin User Configuration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminStrongP@ssw0rd123
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin
ADMIN_PHONE_NUMBER=+33600000001

# Admin Working Hours (optionnel - valeurs par défaut si non définies)
ADMIN_ARRIVAL_TIME=09:00
ADMIN_DEPARTURE_TIME=17:00
ADMIN_LUNCH_DURATION=60
